{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JAY5CXSDMY14/evomap/kit/schemas/plugin-run.schema.json",
  "title": "evo plugin run <名字> <类型> <id> --json",
  "description": "跑一次插件贡献点的结果信封。插件失败也是这个格式（ok=false + error），退出码 3。",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "plugin",
    "kind",
    "id",
    "card",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "大版本。只加字段不升；不兼容的改动才升到 2（App 读到不认识的大版本提示更新）"
    },
    "ok": {
      "type": "boolean"
    },
    "plugin": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "sidebar_page",
        "composer_command",
        "notify_channel",
        "item_action"
      ]
    },
    "id": {
      "type": "string"
    },
    "card": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "card.schema.json"
        }
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "elapsed_ms": {
      "type": "integer"
    },
    "stderr_tail": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
