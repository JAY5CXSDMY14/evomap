#!/usr/bin/env python3
"""假 gh：记下参数。
第十七轮：$FAKE_ORCA_DIR/GH_FAIL 存在时一律报「gh auth login」退出 4；设了 HTTPS_PROXY 就记进 gh_env.log。
issue list：有 $FAKE_ORCA_DIR/gh_issues.json 就按 --label 过滤返回，否则 []。
api repos/.../issues/<n>/events：取 gh_events.json 里 "<n>" 的列表，否则 []。
api repos/.../issues/<n>/comments：取 gh_comments.json 里 "<n>" 的列表，否则 []。issue create：有 $FAKE_ORCA_DIR/gh_next_issue（里面写个数字）就打印这个 issue 的链接（第二十五轮 evo add --new-issue）。
其它命令什么都不输出。"""
import json, os, sys
D = os.environ["FAKE_ORCA_DIR"]
a = sys.argv[1:]
with open(os.path.join(D, "gh.log"), "a", encoding="utf-8") as f:
    f.write(" ".join(a) + "\n")
if os.environ.get("HTTPS_PROXY"):           # 第十七轮：看 gh 有没有带上项目代理（git_env）
    with open(os.path.join(D, "gh_env.log"), "a", encoding="utf-8") as f:
        f.write(os.environ["HTTPS_PROXY"] + "\n")
if os.path.exists(os.path.join(D, "GH_FAIL")):   # 第十七轮：模拟 gh 登录失效
    sys.stderr.write("To get started with GitHub CLI, please run:  gh auth login\n"); sys.exit(4)
def load(n):
    p = os.path.join(D, n)
    return json.load(open(p, encoding="utf-8")) if os.path.exists(p) else None
if a[:2] == ["issue", "list"]:
    lab = a[a.index("--label") + 1] if "--label" in a else None
    iss = load("gh_issues.json") or []
    print(json.dumps([i for i in iss if not lab or lab in [l["name"] for l in i.get("labels", [])]], ensure_ascii=False))
elif a[:1] == ["api"] and a[1].endswith("/comments"):
    n = a[1].split("/")[-2]
    print(json.dumps((load("gh_comments.json") or {}).get(n, []), ensure_ascii=False))
elif a[:1] == ["api"] and a[1].endswith("/events"):
    n = a[1].split("/")[-2]
    print(json.dumps((load("gh_events.json") or {}).get(n, [])))
elif a[:2] == ["issue", "create"] and load("gh_next_issue") is not None:
    print(f"https://github.com/o/r/issues/{load('gh_next_issue')}")
