{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JAY5CXSDMY14/evomap/kit/schemas/feature-list.schema.json",
  "title": "evo feature list --json / evo feature dump --json",
  "description": "第十八轮：内置功能包（kit/features/<id>/）的状态、开关、设置 schema；third_party 是第三方插件层。App 的侧栏页、设置区、自动表单都按它画。",
  "type": "object",
  "required": ["schema_version", "api", "preset", "features"],
  "properties": {
    "schema_version": {"const": 1},
    "api": {"type": "string", "description": "内核接口版本（功能包 manifest 的 api 范围要包含它）"},
    "preset": {"enum": ["all", "essentials"]},
    "file": {"type": "string"},
    "file_error": {"type": ["string", "null"], "description": "features.yml 读不懂时的原因；这时按全开跑，改开关会被拒绝"},
    "third_party": {"type": ["array", "null"], "description": "第三方插件（同 evo plugin list --json 的 plugins）；功能包 plugins 关着时为 null"},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "state", "enabled", "essential", "in_use", "parts", "config"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
          "name": {"type": "string"},
          "sub": {"type": "string"},
          "version": {"type": "string"},
          "api": {"type": ["string", "null"]},
          "essential": {"type": "boolean", "description": "精简预设下也开"},
          "state": {"enum": ["off", "pending", "active", "failed", "disposed"]},
          "why": {"type": "string", "description": "不是 active 时的原因"},
          "enabled": {"type": "boolean", "description": "合成后的开关（含「在用强制开」）"},
          "chosen": {"type": ["boolean", "null"], "description": "features.yml / 预设的意思（不含在用）"},
          "source": {"enum": ["default", "preset", "user", "in_use"]},
          "in_use": {"type": "integer", "minimum": 0, "description": ">0 = 正在用，关不掉"},
          "in_use_text": {"type": "string"},
          "requires": {"type": "array", "items": {"type": "string"}},
          "provides": {"type": "array", "items": {"type": "string"}},
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["slot", "key"],
              "properties": {
                "slot": {"enum": ["cli", "page", "settings", "status", "notify.channel", "prompt.head", "delivery.check"]},
                "key": {"type": "string"},
                "title": {"type": "string"},
                "icon": {"type": "string", "description": "SF Symbols 名"}
              }
            }
          },
          "settings": {
            "type": ["object", "null"],
            "description": "JSON Schema 对象：properties 里每项 {type: boolean|integer|number|string, title, description?, enum?, minimum?, maximum?, default}；x-order 是显示顺序",
            "properties": {
              "type": {"const": "object"},
              "x-order": {"type": "array", "items": {"type": "string"}},
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["type", "title", "default"],
                  "properties": {
                    "type": {"enum": ["boolean", "integer", "number", "string"]},
                    "title": {"type": "string"},
                    "description": {"type": "string"},
                    "enum": {"type": "array"},
                    "minimum": {"type": "number"},
                    "maximum": {"type": "number"}
                  }
                }
              }
            }
          },
          "config": {"type": "object", "description": "合成后的设置值（默认值 ← features.yml）"},
          "config_source": {"type": "object"},
          "subscribes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
