{
  "_说明": "复制为 config.json 后按 Mac mini 实际填写。模型名用 magpie 里的 provider/model。",
  "repo": "~/Desktop/项目/土布/tubu-platform",
  "main_branch": "main",
  "github_repo": "JAY5CXSDMY14/tubu-platform",
  "trusted_authors": [
    "JAY5CXSDMY14"
  ],
  "deploy_cmd": "",
  "push_cmd": "HTTPS_PROXY=socks5h://127.0.0.1:1082 git push origin main",
  "digest_issue": null,
  "orca": "orca",
  "limits": {
    "builders": 2,
    "owner_queue_pause": 5,
    "rework_rounds": 2,
    "stall_minutes": 15
  },
  "roles": {
    "build": {
      "cmd": "dsh",
      "models": [
        "glm/glm-5.3-flash",
        "deepseek/deepseek-v4.1"
      ],
      "prompt": "roles/builder.md"
    },
    "verify": {
      "cmd": "claude",
      "models": [
        "deepseek/deepseek-v4.1",
        "glm/glm-5.3-flash"
      ],
      "prompt": "roles/verifier.md"
    },
    "retro": {
      "prompt": "roles/retro.md"
    }
  },
  "test_cmd": "pytest api/tests tools/tests",
  "policy_terms": "~/Desktop/项目/土布/协作契约/hooks/policy-terms.txt",
  "notify": {
    "macos": true,
    "telegram_bot_token_env": "TUBU_TG_TOKEN",
    "telegram_chat_id_env": "TUBU_TG_CHAT"
  },
  "lessons_file": "docs/LESSONS.md",
  "standards_file": "docs/code-standards.md",
  "nightly_at": "23:30"
}