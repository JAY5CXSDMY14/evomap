{
 "schema_version": 1,
 "evo_api": "1.0",
 "plugins_dir": "/Users/boss/.evoloop/plugins",
 "plugins": [
  {
   "name": "example-hello",
   "version": "0.1.0",
   "description": "示例插件：侧栏页「你好」、输入框命令 /hello、通知渠道（写本地文件）、件详情页按钮",
   "evo_api": "^1",
   "enabled": true,
   "valid": true,
   "compatible": true,
   "active": true,
   "errors": [],
   "contributes": {
    "sidebar_pages": [
     {
      "id": "hello",
      "title": "你好",
      "icon": "hand.wave"
     }
    ],
    "composer_commands": [
     {
      "id": "hello",
      "name": "hello",
      "title": "打个招呼",
      "description": "回一张招呼卡片",
      "usage": "/hello 名字"
     }
    ],
    "notify_channels": [
     {
      "id": "hello-log",
      "title": "写到本地文件",
      "events": "push"
     }
    ],
    "item_actions": [
     {
      "id": "hello-item",
      "title": "跟这件打招呼",
      "icon": "hand.wave"
     }
    ]
   }
  }
 ]
}
