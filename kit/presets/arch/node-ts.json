{
 "_说明": "Node / TypeScript 后端架构预设（第十五轮）。按业务组件分（goldbergyoni/nodebestpractices 1.1），组件内三层 entry-points → domain → data-access（1.2，Web 框架只留在入口层），配置启动时校验、走环境变量（1.4 + 12-factor III）。机器检查：evo 内置检查只看新增；装了 dependency-cruiser 再跑它，改动前后各跑一次只算新违规。仓库已有结构就沿用，evo 只报一次。路径相对 root。",
 "name": "node-ts",
 "title": "Node / TypeScript 后端",
 "lang": "ts",
 "principles": [
  "优先复用成熟库和成熟做法",
  "统一规范",
  "严格限制重复依赖",
  "不重复造轮子",
  "依赖方向单向",
  "按领域分包",
  "配置走环境变量"
 ],
 "sources": [
  {
   "name": "goldbergyoni/nodebestpractices",
   "url": "https://github.com/goldbergyoni/nodebestpractices",
   "license": "CC-BY-SA-4.0（只引用、不拷贝）",
   "take": "1.1 按业务组件分目录；1.2 组件内 entry-points / domain / data-access 三层，Express 不出入口层；1.3 通用工具放 libraries/；1.4 配置分层、启动即校验、密钥不进仓库；2.7 用成熟日志库"
  },
  {
   "name": "sverweij/dependency-cruiser",
   "url": "https://github.com/sverweij/dependency-cruiser",
   "license": "MIT",
   "take": "forbidden 规则强制依赖方向（evo 按本预设分层生成规则，或用仓库自己的 .dependency-cruiser.*）"
  },
  {
   "name": "12factor.net III. Config",
   "url": "https://12factor.net/config",
   "license": "MIT（heroku/12factor）",
   "take": "随部署变化的配置放环境变量"
  }
 ],
 "root": "src",
 "root_candidates": [
  "src",
  "server/src",
  "backend/src",
  "apps/api/src",
  "api/src",
  "server"
 ],
 "layout": "domain",
 "by_type_dirs": [
  "controllers",
  "routes",
  "services",
  "models",
  "repositories",
  "middlewares"
 ],
 "layouts": {
  "domain": {
   "label": "按业务组件分",
   "dirs": [
    "apps",
    "apps/*",
    "apps/*/entry-points",
    "apps/*/entry-points/*",
    "apps/*/domain",
    "apps/*/data-access",
    "apps/*/test",
    "libraries",
    "libraries/*",
    "config"
   ],
   "domain_files": []
  },
  "by-type": {
   "label": "按类型平铺（沿用现有）",
   "dirs": []
  }
 },
 "folders": [
  {
   "path": "src/apps/<组件>/",
   "put": "一个业务组件一个目录（例 orders/、users/），可以有自己的 package.json"
  },
  {
   "path": "src/apps/<组件>/entry-points/api/",
   "put": "HTTP 控制器/路由：只做协议适配（取参数、调 domain、回响应），Web 框架只在这一层出现"
  },
  {
   "path": "src/apps/<组件>/entry-points/message-queue/",
   "put": "消息消费者、定时任务入口"
  },
  {
   "path": "src/apps/<组件>/domain/",
   "put": "业务流程、DTO、服务；只收发普通对象，不认识 HTTP"
  },
  {
   "path": "src/apps/<组件>/data-access/",
   "put": "数据库访问（仓储模式），对外返回普通对象"
  },
  {
   "path": "src/apps/<组件>/test/",
   "put": "组件测试"
  },
  {
   "path": "src/libraries/<名字>/",
   "put": "跨组件通用的东西（日志、鉴权、配置读取），像独立包一样写"
  },
  {
   "path": "src/config/",
   "put": "配置：启动时用 zod 校验 process.env，缺了立刻退出"
  },
  {
   "path": "docs/decisions/",
   "put": "架构决策记录（ADR，MADR 模板）"
  }
 ],
 "repo_dirs": [
  "src",
  "server",
  "backend",
  "apps",
  "packages",
  "libs",
  "test",
  "tests",
  "__tests__",
  "docs",
  "scripts",
  "tools",
  "prisma",
  "drizzle",
  "migrations",
  "public",
  "web",
  "frontend",
  ".github",
  ".vscode",
  "deploy",
  "docker"
 ],
 "test_dirs": [
  "test",
  "test/*",
  "tests",
  "tests/*",
  "__tests__",
  "*/__tests__",
  "*/test",
  "*/tests"
 ],
 "layers": [
  {
   "name": "entry",
   "label": "入口层（entry-points / controllers / routes）",
   "match": [
    "main.ts",
    "server.ts",
    "index.ts",
    "app.ts",
    "*/entry-points/*",
    "entry-points/*",
    "controllers/*",
    "*/controllers/*",
    "routes/*",
    "*/routes/*",
    "*/api/*"
   ]
  },
  {
   "name": "domain",
   "label": "业务层（domain / services）",
   "match": [
    "*/domain/*",
    "domain/*",
    "services/*",
    "*/services/*",
    "*.service.ts"
   ],
   "forbid_imports": [
    "express",
    "fastify",
    "koa",
    "@koa/*",
    "@fastify/*",
    "hapi",
    "@hapi/*"
   ]
  },
  {
   "name": "data",
   "label": "数据访问层（data-access / repositories）",
   "match": [
    "*/data-access/*",
    "data-access/*",
    "repositories/*",
    "*/repositories/*",
    "*.repository.ts",
    "models/*",
    "*/models/*"
   ],
   "forbid_imports": [
    "express",
    "fastify",
    "koa",
    "@koa/*",
    "@fastify/*",
    "hapi",
    "@hapi/*"
   ]
  },
  {
   "name": "lib",
   "label": "通用层（libraries / config）",
   "match": [
    "libraries/*",
    "*/libraries/*",
    "config/*",
    "config.ts",
    "lib/*",
    "utils/*"
   ]
  }
 ],
 "config_modules": [
  "config/*",
  "config.ts",
  "*/config/*",
  "*/config.ts",
  "env.ts",
  "*/env.ts"
 ],
 "env_reads": [
  "process.env"
 ],
 "migrations": {
  "dir": "migrations",
  "pattern": "^\\d{8,14}[_-][a-z0-9_-]+\\.(ts|js|sql)$",
  "alt_dirs": [
   "migrations",
   "prisma/migrations",
   "drizzle",
   "db/migrations",
   "src/migrations"
  ],
  "label": "时间戳_slug"
 },
 "adr_dir": "docs/decisions",
 "categories": {
  "web": {
   "label": "Web 框架",
   "source": "suggested",
   "choice": "Fastify（TypeScript 友好、自带 schema 校验和 pino 日志）",
   "packages": [
    "fastify",
    "@fastify/*"
   ],
   "banned": [
    "express",
    "koa",
    "@koa/*",
    "hapi",
    "@hapi/hapi",
    "restify",
    "@nestjs/*",
    "sails",
    "loopback",
    "@loopback/*",
    "polka"
   ]
  },
  "validation": {
   "label": "数据校验",
   "source": "suggested",
   "choice": "zod（和前端 web-react 预设同一个）",
   "packages": [
    "zod"
   ],
   "banned": [
    "joi",
    "yup",
    "class-validator",
    "superstruct",
    "valibot",
    "io-ts",
    "runtypes",
    "ajv"
   ]
  },
  "config": {
   "label": "配置",
   "source": "suggested",
   "choice": "process.env + zod 启动校验（Node 20+ 可用 --env-file 读 .env）",
   "packages": [],
   "banned": [
    "config",
    "nconf",
    "convict",
    "rc",
    "dotenv-flow",
    "env-cmd"
   ]
  },
  "logging": {
   "label": "日志",
   "source": "suggested",
   "choice": "pino（Fastify 内置）",
   "packages": [
    "pino",
    "pino-*"
   ],
   "banned": [
    "winston",
    "bunyan",
    "log4js",
    "signale",
    "consola",
    "morgan"
   ]
  },
  "http": {
   "label": "HTTP 客户端",
   "source": "suggested",
   "choice": "原生 fetch（undici）",
   "packages": [
    "undici"
   ],
   "banned": [
    "axios",
    "node-fetch",
    "got",
    "superagent",
    "request",
    "needle",
    "cross-fetch",
    "isomorphic-fetch"
   ]
  },
  "tests": {
   "label": "测试",
   "source": "suggested",
   "choice": "Vitest",
   "packages": [
    "vitest",
    "@vitest/*"
   ],
   "banned": [
    "jest",
    "mocha",
    "ava",
    "jasmine",
    "tap",
    "uvu"
   ]
  },
  "lint": {
   "label": "代码检查",
   "source": "suggested",
   "choice": "ESLint + typescript-eslint（格式化 Prettier）",
   "packages": [
    "eslint",
    "typescript-eslint",
    "@typescript-eslint/*",
    "prettier"
   ],
   "banned": [
    "tslint",
    "standard",
    "xo",
    "jshint",
    "jscs",
    "@biomejs/biome",
    "rome"
   ]
  },
  "deps-check": {
   "label": "依赖方向检查",
   "source": "suggested",
   "choice": "dependency-cruiser",
   "packages": [
    "dependency-cruiser"
   ],
   "banned": [
    "madge",
    "eslint-plugin-boundaries"
   ]
  }
 },
 "checks": [
  {
   "id": "builtin",
   "label": "evo 内置结构检查",
   "cmd": "evo -p {CODE} arch check",
   "tool": "",
   "install": "",
   "what": "新目录、向上依赖、Web 框架越出入口层、迁移命名、重复依赖、写死口令；只看本件新增"
  },
  {
   "id": "dependency-cruiser",
   "label": "dependency-cruiser 分层规则",
   "cmd": "npx --no-install depcruise <root> --config <规则> --output-type err",
   "tool": "depcruise",
   "install": "npm i -D dependency-cruiser（或 pnpm add -D dependency-cruiser）",
   "what": "仓库有 .dependency-cruiser.* 就用它；没有就按本预设分层生成规则。改动前后各跑一次，只算新出现的违规"
  }
 ],
 "rules": [
  "只管新写的代码；老代码不整体迁移。仓库已有自己的目录结构（例如 controllers/ services/ models/ 平铺），新代码沿用现有结构，evo 只报一次。",
  "红线：新开目录、新分层、换库，一律先 ask 决策岗；老板批准后写进项目 arch_overrides，并在 docs/decisions/ 补一份 ADR（MADR 模板）。自己开新目录、新分层，验收直接打回。",
  "依赖方向单向：入口层 → 业务层（domain）→ 数据访问层（data-access）→ 通用层（libraries / config）。下层不许 import 上层；domain 和 data-access 里不许出现 express / fastify / koa（Web 框架只在入口层）。",
  "按业务组件分：新业务进 src/apps/<组件>/，组件内三层目录；跨组件通用的东西进 src/libraries/，不复制粘贴。组件之间只通过对方的 domain 公开函数调用，不直接读别人的 data-access。",
  "配置走环境变量：只在 config 模块读 process.env，启动时用 zod 校验，缺了立刻退出；别处 import config。新变量同步写进 .env.example（占位值）。代码里不写死口令。",
  "错误：扩展内置 Error，集中处理；用 pino 记日志，不用 console.log 做业务日志。",
  "先用已选的库：Web 用 Fastify、校验用 zod、日志用 pino、HTTP 用原生 fetch；上表覆盖不了才加新依赖，并在交卷 changes 写明为什么。"
 ]
}