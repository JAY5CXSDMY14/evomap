{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JAY5CXSDMY14/evomap/kit/schemas/card.schema.json",
  "title": "插件卡片（schema_version 1）",
  "description": "插件命令往 stdout 写的 JSON；App 用通用渲染器画。块只有 text / list / table / buttons 四种。",
  "type": "object",
  "required": [
    "title"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string"
              },
              "style": {
                "enum": [
                  "body",
                  "caption",
                  "title",
                  "mono"
                ]
              },
              "tone": {
                "enum": [
                  "neutral",
                  "accent",
                  "success",
                  "warning",
                  "danger"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "items"
            ],
            "properties": {
              "type": {
                "const": "list"
              },
              "items": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "required": [
                    "title"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "badge": {
                      "type": "string"
                    },
                    "symbol": {
                      "type": "string",
                      "description": "SF Symbols 名"
                    },
                    "tone": {
                      "enum": [
                        "neutral",
                        "accent",
                        "success",
                        "warning",
                        "danger"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "columns",
              "rows"
            ],
            "properties": {
              "type": {
                "const": "table"
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "buttons"
            ],
            "properties": {
              "type": {
                "const": "buttons"
              },
              "buttons": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "action"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string",
                      "minLength": 1
                    },
                    "style": {
                      "enum": [
                        "primary",
                        "secondary",
                        "danger"
                      ]
                    },
                    "payload": {}
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
