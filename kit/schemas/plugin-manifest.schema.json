{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JAY5CXSDMY14/evomap/kit/schemas/plugin-manifest.schema.json",
  "title": "plugin.json（插件 manifest）",
  "description": "~/.evoloop/plugins/<名字>/plugin.json。写法参考 VS Code 扩展 package.json 的 engines + contributes。",
  "type": "object",
  "required": [
    "name",
    "version",
    "evo_api",
    "contributes"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "evo_api": {
      "type": "string",
      "description": "兼容的插件接口范围（semver 子集）：^1、>=1 <2、1、*"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "contributes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "sidebar_pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "run"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "title": {
                "type": "string",
                "maxLength": 40
              },
              "icon": {
                "type": "string"
              },
              "run": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "命令行；第一个词 python3 = evo 用的同一个 python，相对路径 = 插件目录里的文件"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              }
            }
          }
        },
        "composer_commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "title",
              "run"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,23}$"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "usage": {
                "type": "string"
              },
              "run": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "命令行；第一个词 python3 = evo 用的同一个 python，相对路径 = 插件目录里的文件"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              }
            }
          }
        },
        "notify_channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "run"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "title": {
                "type": "string"
              },
              "events": {
                "enum": [
                  "push",
                  "all"
                ]
              },
              "run": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "命令行；第一个词 python3 = evo 用的同一个 python，相对路径 = 插件目录里的文件"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              }
            }
          }
        },
        "item_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "run"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "title": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "run": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "命令行；第一个词 python3 = evo 用的同一个 python，相对路径 = 插件目录里的文件"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
