    x.add_argument("--force", action="store_true")
    x = sp.add_parser("plugin", help="插件：list | enable <名> | disable <名> | run <名> <类型> <id> | validate [名|目录] | install <目录>")   # 第十六轮
    x.add_argument("action", choices=["list", "enable", "disable", "run", "validate", "install"])
    x.add_argument("target", nargs="?"); x.add_argument("kind", nargs="?"); x.add_argument("cid", nargs="?")
    x.add_argument("--json", action="store_true"); x.add_argument("--args", dest="pargs", default="")
    x.add_argument("--action", dest="paction"); x.add_argument("--payload"); x.add_argument("--project"); x.add_argument("--item")
    x.add_argument("--force", action="store_true")
    x = sp.add_parser("feature", help="功能开关（第十八轮）：list | on <id> | off <id> | set <id> 键=值 | preset all|essentials | dump")
    x.add_argument("action", nargs="?", choices=["list", "on", "off", "set", "preset", "dump"]); x.add_argument("target", nargs="?")
    x.add_argument("kv", nargs="*"); x.add_argument("--json", action="store_true")
    x = sp.add_parser("watch", help="事件流（第十八轮）：--json 每行一个事件，App 订阅它")
    x.add_argument("--json", action="store_true"); x.add_argument("--replay", type=int, default=0, help="先吐最后 N 条")
    x.add_argument("--ping", type=int, default=15, help="多少秒没事件吐一行 watch.ping"); x.add_argument("--seconds", type=float, default=0, help=argparse.SUPPRESS)
    x.add_argument("--project-only", dest="project_only", action="store_true", help="只要 -p 这个项目的事件")
    FEATURE_CMDS = {}
    for f in sorted(rt().features.values(), key=lambda f: f.id):     # 功能包的子命令：开着用它的，关着给一个说明
        for part in f.m.get("parts") or []:
            if part.get("slot") != "cli" or part.get("key") in FEATURE_CMDS:
                continue
            nm = part["key"]
            c = rt().contribution("cli", nm)
            if c:
                x = sp.add_parser(nm, help=c.get("help"))
                c["setup"](x)
                FEATURE_CMDS[nm] = (c["run"], c.get("no_project", False))
            else:
                x = sp.add_parser(nm, help=f"（功能 {f.id} 关着）"); x.add_argument("rest", nargs=argparse.REMAINDER)
                FEATURE_CMDS[nm] = (feature_off_stub(f, nm), True)
    a = p.parse_args()
    if a.cmd in ("feature", "watch"):
        sys.exit({"feature": cmd_feature, "watch": cmd_watch}[a.cmd](a) or 0)
    if a.cmd in FEATURE_CMDS and FEATURE_CMDS[a.cmd][1]:
        sys.exit(FEATURE_CMDS[a.cmd][0](a) or 0)
    if a.cmd == "team":                                    # 第十四轮：不选项目也能看/改（全局卡片）
        cmd_team(a); sys.exit(0)
    if a.cmd == "plugin":                                  # 第十六轮：插件和项目无关
        sys.exit(cmd_plugin(a) or 0)
    if not HAS_PROJECT and a.cmd not in ("new", "import", "projects", "status", "run", "suite", "panel", "notify-test", "bot", "watchdog", "models"):
        sys.exit(f"有多个项目，请加 -p <代号>：{', '.join(list_projects()) or '（还没有项目）'}")
    if a.cmd in FEATURE_CMDS:
        sys.exit(FEATURE_CMDS[a.cmd][0](a) or 0)
    {"panel": cmd_panel, "new": cmd_new, "import": cmd_import, "projects": cmd_projects, "once": cmd_once, "add": cmd_add, "tick": cmd_tick, "run": cmd_run, "status": cmd_status, "approve": cmd_approve, "ship": cmd_ship, "pull": cmd_pull, "retry": cmd_retry, "resume": cmd_resume, "feedback": cmd_feedback, "suite": cmd_suite, "retro": cmd_retro,
     "notify-test": cmd_notify_test, "watchdog": cmd_watchdog, "models": cmd_models, "log": cmd_log,
     "goal": cmd_goal, "relocate": cmd_relocate}[a.cmd](a)
